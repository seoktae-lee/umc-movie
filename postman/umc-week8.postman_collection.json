{
  "info": {
    "name": "UMC 8주차 - 즐겨찾기와 영화 기록",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "먼저 7주차 POST /auth/login으로 받은 accessToken을 컬렉션 변수 accessToken에 넣는다. 영화 ID는 매번 새 회원이라는 전제다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "POST /favorites 등록(201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/favorites",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 550\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"code COMMON201\", () => pm.expect(pm.response.json().code).to.eql(\"COMMON201\"));"
            ]
          }
        }
      ]
    },
