{
  "info": {
    "name": "UMC 5주차 - 영화 평점 서비스",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 닉네임 중복 체크 - 이미 있음(수현)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/members/nickname/수현",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "nickname",
            "수현"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 & available=false', ()=>{pm.response.to.have.status(200); pm.expect(pm.response.json().available).to.eql(false);});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. 닉네임 중복 체크 - 사용 가능(태이)",
