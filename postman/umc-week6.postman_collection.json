  "item": [
    {
      "name": "1. 회원가입 성공",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"umc@example.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"moviefan\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', ()=>pm.response.to.have.status(201));",
              "pm.test('code COMMON201', ()=>pm.expect(pm.response.json().code).to.eql('COMMON201'));",
              "pm.test('password가 응답에 없다', ()=>pm.expect(pm.response.json().result).to.not.have.property('password'));",
              "pm.collectionVariables.set('newMemberId', pm.response.json().result.memberId);"
            ]
          }
        }
      ]
    },
