    "name": "UMC 7주차 - 로그인과 토큰 기반 API",
    "description": "실행 전 DB 초기화: mysql -uroot < docs/sql/03_reset_week6.sql\n위에서부터 순서대로 실행한다. 로그인 요청이 토큰을 변수에 저장한다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01. 회원가입 A (6주차 API는 토큰 없이)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"movie@umc.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"영화광\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('code COMMON201', () => pm.expect(pm.response.json().code).to.eql('COMMON201'));",
              "pm.test('password가 응답에 없다', () => pm.expect(pm.response.text()).to.not.include('password'));",
              "pm.collectionVariables.set('memberIdA', pm.response.json().result.memberId);"
            ]
          }
        }
      ]
    },
