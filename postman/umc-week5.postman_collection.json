    {
      "name": "5. 유저별 평점 조회 - 1번 회원(최신순)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/members/1/ratings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "1",
            "ratings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 & 2건 최신순', ()=>{pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b.length).to.eql(2); pm.expect(b[0].ratingId).to.be.above(b[1].ratingId);});"
            ]
          }
        }
      ]
    },
