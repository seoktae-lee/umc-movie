    {
      "name": "10. 내 정보 조회 - payload 한 글자 바꾼 토큰(401)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/members/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "me"
          ]
        },
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{forgedToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('code AUTH401_3', () => pm.expect(pm.response.json().code).to.eql('AUTH401_3'));",
              "pm.test('실패 형식: isSuccess=false, result=null', () => { const b = pm.response.json(); pm.expect(b.isSuccess).to.eql(false); pm.expect(b.result).to.eql(null); });"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 가운데(payload)의 글자 하나를 다른 글자로 바꾼다. 맨 뒤에 덧붙이는 방식은 통과할 수 있다.",
              "const p = pm.collectionVariables.get('tokenA').split('.');",
              "const c = p[1][10];",
              "p[1] = p[1].slice(0, 10) + (c === 'A' ? 'B' : 'A') + p[1].slice(11);",
              "pm.collectionVariables.set('forgedToken', p.join('.'));"
            ]
          }
        }
      ]
    },
