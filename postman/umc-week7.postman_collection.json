              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('code COMMON200', () => pm.expect(pm.response.json().code).to.eql('COMMON200'));",
              "pm.test('password가 응답에 없다', () => pm.expect(pm.response.text()).to.not.include('password'));",
              "const r = pm.response.json().result;",
              "pm.test('nickname과 accessToken을 돌려준다', () => pm.expect(r.nickname).to.eql('영화광'));",
              "pm.test('토큰은 점으로 나뉜 세 덩어리', () => pm.expect(r.accessToken.split('.').length).to.eql(3));",
              "pm.collectionVariables.set('tokenA', r.accessToken);"
            ]
          }
        }
      ]
