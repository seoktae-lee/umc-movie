    {
      "name": "12. CORS - 허용 출처(5173)에서 온 요청",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:5173"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members/nickname/태이",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "nickname",
            "태이"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Access-Control-Allow-Origin: http://localhost:5173', ()=>pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5173'));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. CORS - 허용하지 않은 출처(5174)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:5174"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/members/nickname/태이",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "nickname",
            "태이"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 & 헤더 없음', ()=>{pm.response.to.have.status(403); pm.expect(pm.response.headers.has('Access-Control-Allow-Origin')).to.eql(false);});"
            ]
          }
        }
      ]
    }
